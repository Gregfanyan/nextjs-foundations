# Client-accessible (bundled in JavaScript at build time)
# Only use for public data such as analytics IDs
NEXT_PUBLIC_APP_NAME="Your App Name"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Google Analytics measurement ID (optional - leave empty to disable)
NEXT_PUBLIC_GA_ID=""

# Server-only (not available in Client Components)
# Safe for secrets - never prefix these with NEXT_PUBLIC_
INTERNAL_CONFIG="your-server-config"
DATABASE_URL="postgresql://user:password@localhost/db"
# URL of the deployed blog app (used by the /blog rewrites). Defaults to localhost:3001
BLOG_URL="http://localhost:3001"

# Bearer token for /api/transactions (placeholder auth)
API_TOKEN="change-me"

# Vercel Swag Store API bypass token (server-only)
SWAG_STORE_API_TOKEN=""
